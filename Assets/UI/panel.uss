.panel {
    opacity: 1;
    display: flex;
    visibility: visible;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0);
    background-position-x: center 0;
    justify-content: flex-start;
    align-self: auto;
    align-content: auto;
    align-items: auto;
    flex-wrap: nowrap;
    flex-direction: column;
    overflow: visible;
    flex-shrink: 1;
    flex-basis: auto;
}

.container {
    -unity-text-align: upper-left;
    background-color: rgba(0, 255, 29, 0.25);
    padding-bottom: 15px;
    padding-top: 15px;
    padding-right: 15px;
    padding-left: 15px;
}

.selection-button {
    font-size: 30px;
    align-content: flex-start;
}
