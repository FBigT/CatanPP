/* Corner HUD positioning */
#DevCardPanel  /* the root element’s name—set this in UXML inspector if not already */
{
  position: absolute;
  top: 10px; right: 10px;
  width: 250px;
  height: 300px;
  background-color: rgba(0,0,0,0.7);
  border-radius: 8px;
  padding: 8px;
  display: flex;
  flex-direction: column;
}

/* ScrollView inside the panel */
#DevCardScroll {
  flex-grow: 1;
  background-color: #222;
  border-radius: 4px;
  padding: 4px;
  overflow-y: auto;
}

/* Card root styling */
.CardRoot {
  width: 100%;
  background-color: #333;
  border-radius: 4px;
  padding: 4px;
  margin-bottom: 6px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Icon slot sized */
.card-icon {
  width: 48px;
  height: 48px;
  margin: 4px 0;
}

/* Title & description */
.Title { unity-font-style: bold; color: white; }
.Desc  { font-size: 12px; color: #ddd; text-align: center; }

/* Play button */
#PlayButton {
  margin-top: 4px;
  width: 80%;
  height: 24px;
  background-color: #66cc66;
  color: white;
  unity-text-align: center;
}
