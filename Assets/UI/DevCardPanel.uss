/* Main Panel */
#DevCardPanel {
    border-width: 2px;
    border-color: rgb(100, 100, 100);
}

/* Individual Card Styling */
.CardRoot {
    width: 100%;
    background-color: rgba(51, 51, 51, 0.95);
    border-radius: 6px;
    padding: 8px;
    margin-bottom: 8px;
    flex-direction: column;
    align-items: center;
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    min-height: 120px;
}

.CardRoot:hover {
    background-color: rgba(70, 70, 70, 0.95);
    border-color: rgb(120, 120, 120);
}

/* Card Icon */
.card-icon {
    width: 64px;
    height: 64px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center center;
    margin: 4px 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(150, 150, 150, 0.5);
}

/* Card Text */
.Title { 
    -unity-font-style: bold; 
    color: white; 
    -unity-text-align: middle-center;
    font-size: 13px;
    margin: 3px 0;
}

.Desc { 
    font-size: 10px; 
    color: rgb(200, 200, 200); 
    -unity-text-align: middle-center; 
    white-space: normal;
    margin: 2px 0;
    max-width: 200px;
}

/* Play Button */
#PlayButton {
    margin-top: 6px;
    width: 85%;
    height: 26px;
    background-color: rgb(102, 204, 102);
    color: white;
    -unity-text-align: middle-center;
    border-radius: 4px;
    border-width: 0;
    -unity-font-style: bold;
}

#PlayButton:hover {
    background-color: rgb(120, 220, 120);
}

#PlayButton:disabled {
    background-color: rgb(80, 80, 80);
    color: rgb(140, 140, 140);
}

/* Buy Button */
#BuyCardButton:hover {
    background-color: rgb(120, 220, 120);
}

/* Count Badge */
.card-count {
    position: absolute;
    top: 4px;
    right: 4px;
    background-color: rgba(255, 165, 0, 0.9);
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 10px;
    min-width: 20px;
    -unity-text-align: middle-center;
}
