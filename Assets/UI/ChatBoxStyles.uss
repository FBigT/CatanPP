#ChatBox {
    flex-direction: column;
    flex-grow: 1;
    max-width: 30%;
    max-height: 40%;
    background-color: rgba(0, 0, 0, 0.18);
}

/* ChatContainer (ListView) should take ~80% of the height */
#ChatContainer {
    flex-grow: 9;
    flex-shrink: 1;
    height: auto;
    overflow-y: auto;
}

/* ChatInput should take ~20% of the height */
#ChatInput {
    flex-grow: 1;
    flex-shrink: 1;
    height: auto;
    min-height: 25px;
    margin: 0;
    padding: 2px;
    font-size: 12px;
}

.unity-list-view__empty-label {
    display: none;
}

.no-padding-textfield {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-padding: 0;
}



.chat-label {
    white-space: normal;
    overflow: visible;
    unity-text-align: upper-left;
    unity-text-overflow-position: end;
    flex-grow: 0;
    flex-shrink: 1;
    word-wrap: break-word;
}

#ChatEntry {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}