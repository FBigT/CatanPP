/* Root settings: ensure the document fills the screen */
:root {
    position: relative;
    width: 100%;
    height: 100%;
}

/* Container for the resource bar (cyberpunk style) */
.top-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 40px;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    /* Cyberpunk gradient background */
    background: linear-gradient(135deg, #0ff, #f0f, #0ff);
    /* Neon glow effect */
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.8), 0 0 20px rgba(255, 0, 255, 0.8);
    padding: 5px 10px;
}

/* Style for each resource label (applied to labels that have class 'resource-label') */
.resource-label {
    font-family: "Noto Color Emoji"; /* This is a fallback; the font is also set in script */
    font-size: 16px;
    color: white;
    margin: 0 5px;
    /* Optional: add a subtle text shadow for extra neon effect */
    text-shadow: 0 0 3px #0ff, 0 0 5px #f0f;
}
