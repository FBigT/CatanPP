<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/DevCardPanel.uss?fileID=7433441132597879392&amp;guid=430fb6653ac49ec40851fd23f6f84116&amp;type=3#DevCardPanel" />
    <engine:VisualElement name="DevCardPanel" class="dev-card-panel" style="flex-grow: 1;">
        <engine:VisualElement style="flex-grow: 1;">
            <engine:Label text="Development Cards" />
            <engine:Button text="✕" name="CloseButton" />
        </engine:VisualElement>
        <engine:ScrollView name="DevCardScroll" class="card-scroll" />
        <engine:Button text="Buy Dev Card" name="BuyCardButton" />
    </engine:VisualElement>
</engine:UXML>
